{
  "crmGet": {
    "schema": {
      "method": "GET",
      "host": "<%= iparam.crmDomain %>",
      "path": "<%= context.path %>",
      "headers": {
        "Authorization": "Token token=<%= iparam.crmApiKey %>",
        "Accept": "application/json",
        "Content-Type": "application/json"
      }
    }
  }
}
